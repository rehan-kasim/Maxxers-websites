{
    "display_information": {
        "name": "maxxer",
        "description": "A feature-rich Slack assistant powered by Google Gemini.",
        "long_description": "Chat with Gemini in DMs and channels, attach and analyze files, summarize threads and channels, search the web, read links, explain messages, and generate images. Built with Slack Bolt and the Google Gen AI SDK.",
        "background_color": "#1a1a2e"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": true,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false
        },
        "bot_user": {
            "display_name": "maxxer",
            "always_online": true
        },
        "shortcuts": [
            {
                "name": "Explain this message",
                "type": "message",
                "callback_id": "explain_message",
                "description": "Get a private explanation of this message"
            },
            {
                "name": "Summarize thread",
                "type": "message",
                "callback_id": "summarize_thread",
                "description": "Summarize this thread with Gemini"
            },
            {
                "name": "Search the web",
                "type": "message",
                "callback_id": "search_web",
                "description": "Search the web for this message"
            },
            {
                "name": "Reset thread memory",
                "type": "message",
                "callback_id": "reset_thread",
                "description": "Clear the assistant's memory for this thread"
            },
            {
                "name": "Read this link",
                "type": "message",
                "callback_id": "read_link",
                "description": "Read and summarize links in this message"
            }
        ],
        "slash_commands": [
            {
                "command": "/maxxerask",
                "description": "Ask Gemini a question",
                "should_escape": false,
                "usage_hint": "<question>"
            },
            {
                "command": "/maxxersearch",
                "description": "Search the web with Gemini",
                "should_escape": false,
                "usage_hint": "<query>"
            },
            {
                "command": "/maxxerwebsite",
                "description": "Build and publish a static website using GitHub Pages",
                "should_escape": false,
                "usage_hint": "<name> | <description> [--update]"
            },
            {
                "command": "/maxxersummarize",
                "description": "Summarize a channel or thread",
                "should_escape": false,
                "usage_hint": "[message count]"
            },
            {
                "command": "/maxxerimage",
                "description": "Generate an image with Gemini",
                "should_escape": false,
                "usage_hint": "[--ar 16:9] <prompt>"
            },
            {
                "command": "/maxxerreset",
                "description": "Clear conversation memory",
                "should_escape": false,
                "usage_hint": "[all]"
            },
            {
                "command": "/maxxermodel",
                "description": "Show the active model and memory statistics",
                "should_escape": false
            },
            {
                "command": "/maxxerhelp",
                "description": "Show assistant capabilities and commands",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "app_mentions:read",
                "channels:history",
                "channels:read",
                "chat:write",
                "commands",
                "files:read",
                "files:write",
                "groups:history",
                "groups:read",
                "im:history",
                "im:read",
                "mpim:history",
                "mpim:read",
                "reactions:write",
                "users:read"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_home_opened",
                "app_mention",
                "message.im",
                "message.channels",
                "message.groups"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "is_mcp_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": true
    }
}
