{
  "display_information": {
    "name": "maxxer",
    "description": "A feature-rich Slack assistant powered by Google Gemini.",
    "background_color": "#1a1a2e",
    "long_description": "Chat with Gemini in DMs and channels, attach files, summarize threads and channels, and generate images. Built with Slack Bolt and the Google Gen AI SDK."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "maxxer",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Search the web",
        "type": "message",
        "callback_id": "search_web",
        "description": "Search the web for this message"
      },
      {
        "name": "Read this link",
        "type": "message",
        "callback_id": "read_link",
        "description": "Read and summarize links in this message"
      },
      {
        "name": "Summarize thread",
        "type": "message",
        "callback_id": "summarize_thread",
        "description": "Summarize this thread with Gemini"
      },
      {
        "name": "Explain this message",
        "type": "message",
        "callback_id": "explain_message",
        "description": "Get a private explanation of this message"
      },
      {
        "name": "Reset thread memory",
        "type": "message",
        "callback_id": "reset_thread",
        "description": "Forget the assistant's conversation memory for this thread"
      }
    ],
    "slash_commands": [
      {
        "command": "/ask",
        "description": "Ask Gemini a question in this channel",
        "usage_hint": "<question>",
        "should_escape": false
      },
      {
        "command": "/search",
        "description": "Search the web with Gemini",
        "usage_hint": "<query>",
        "should_escape": false
      },
      {
        "command": "/website",
        "description": "Build a static website and publish it to GitHub Pages",
        "usage_hint": "<name> | <description>  (add --update to replace)",
        "should_escape": false
      },
      {
        "command": "/summarize",
        "description": "Summarize this channel or thread",
        "usage_hint": "[message count]",
        "should_escape": false
      },
      {
        "command": "/image",
        "description": "Generate an image with Gemini",
        "usage_hint": "[--ar 16:9] <prompt>",
        "should_escape": false
      },
      {
        "command": "/reset",
        "description": "Clear the assistant's conversation memory",
        "usage_hint": "[all]",
        "should_escape": false
      },
      {
        "command": "/model",
        "description": "Show the active model and memory stats",
        "should_escape": false
      },
      {
        "command": "/gemini-help",
        "description": "Show the assistant's capabilities",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.im",
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "app_level_token_rotation_enabled": true,
    "token_rotation_enabled": false
  }
}
